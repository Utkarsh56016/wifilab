#!/usr/bin/env bash

set -euo pipefail

SOURCE=${BASH_SOURCE[0]}
while [[ -L "$SOURCE" ]]; do
    SOURCE_DIR=$(cd -P -- "$(dirname -- "$SOURCE")" && pwd)
    TARGET=$(readlink -- "$SOURCE")
    if [[ $TARGET == /* ]]; then
        SOURCE=$TARGET
    else
        SOURCE="$SOURCE_DIR/$TARGET"
    fi
done

SCRIPT_DIR=$(cd -P -- "$(dirname -- "$SOURCE")" && pwd)
ROOT_DIR=$(cd -- "$SCRIPT_DIR/.." && pwd)

source "$ROOT_DIR/lib/wifilab/discover.sh"
source "$ROOT_DIR/lib/wifilab/radio.sh"
source "$ROOT_DIR/lib/wifilab/state.sh"
source "$ROOT_DIR/lib/wifilab/safety.sh"
source "$ROOT_DIR/lib/wifilab/json.sh"
source "$ROOT_DIR/lib/wifilab/select.sh"
source "$ROOT_DIR/lib/wifilab/telemetry.sh"
source "$ROOT_DIR/lib/wifilab/capture.sh"
source "$ROOT_DIR/lib/wifilab/capture_inventory.sh"
source "$ROOT_DIR/lib/wifilab/capture_analysis.sh"
source "$ROOT_DIR/lib/wifilab/capture_inspect.sh"

usage() {
    cat <<'EOF'
WiFiLab

Usage:
  wifilab adapters
  wifilab list
  wifilab info
  wifilab --json
  wifilab doctor
  wifilab select [iface]
  wifilab status [--json]
  wifilab radio --json
  wifilab channels --json
  wifilab telemetry --json
  wifilab protocols --json
  wifilab capture status --json
  wifilab capture run [duration_seconds] [max_kib]
  wifilab capture latest --json
  wifilab capture protocols <capture_id|latest> --json
  wifilab capture inspect <capture_id|latest> --json
  wifilab captures --json
  wifilab monitor [iface]
  wifilab managed [iface]
  wifilab restore [iface]
  wifilab channel [iface] <channel>
  wifilab help

Discovery:
  adapters  Show discovered wireless adapters
  list      Alias for adapters
  info      Alias for adapters
  --json    Emit machine-readable adapter discovery output
  doctor    Check dependencies and basic discovery health

Selection:
  select    Persist a physical lab-adapter identity. With no interface,
            auto-select the sole idle USB wireless candidate.
  status    Resolve the selected physical adapter to its current runtime
            interface and show live state. Add --json for UI/agent use.

Read-only UI/agent data:
  radio --json
            Emit the selected adapter's current channel/frequency when known.
  channels --json
            Emit kernel-advertised channels and regulatory flags for the
            selected adapter PHY.
  telemetry --json
            Emit selected-interface RX/TX byte/packet counters. The UI derives
            rates from consecutive samples without packet capture or root.
  protocols --json
            Analyze the newest saved WiFiLab capture offline with tshark -r.
            This compatibility command never opens a live capture interface.
  capture status --json
            Report whether bounded passive capture is available, permitted,
            safe for the selected adapter, and ready in the current radio mode.
  capture latest --json
            Emit the newest WiFiLab-created capture with manifest-backed
            historical radio metadata when available.
  capture protocols <capture_id|latest> --json
            Analyze one validated WiFiLab-owned saved PCAPNG offline. Capture
            identifiers are confined to the WiFiLab capture directory; symbolic
            links and arbitrary filesystem paths are refused.
  capture inspect <capture_id|latest> --json
            Inspect one validated saved PCAPNG on demand. Returns lightweight
            inventory metadata, SHA-256 integrity state, and capinfos-derived
            file type, encapsulation, packet count, size, duration and timestamps.
  captures --json
            List WiFiLab-created captures. Existing name/bytes/file fields are
            retained while richer capture metadata is added.

Capture:
  capture run [duration_seconds] [max_kib]
            Save one bounded passive pcapng from the selected physical adapter.
            Defaults: 10 seconds and 10240 KiB. Allowed duration: 1..300 seconds.
            Allowed size limit: 256..102400 KiB. Capture requires monitor mode,
            refuses protected/default-route interfaces, and never uses sudo,
            pkexec, or the privileged radio helper.

State commands:
  monitor   Switch the selected adapter to monitor mode. An explicit iface
            may still be supplied for diagnostics or recovery.
  managed   Switch the selected adapter to managed mode and return it to
            NetworkManager.
  restore   Deterministically restore the selected adapter to managed mode
            with NetworkManager ownership.
  channel   Set a monitor-mode channel. Usage: `wifilab channel 11` for the
            selected adapter, or `wifilab channel wlan6 11` explicitly.

Safety:
  WiFiLab refuses state changes on wireless interfaces carrying an active
  NetworkManager connection or a system default route. Selection stores
  physical metadata rather than wlanX/phyX names. WiFiLab never globally
  kills or restarts NetworkManager. Passive capture resolves that same physical
  selection again at capture time and refuses protected interfaces. Saved-PCAP
  analysis and inspection are read-only and never open a live wireless interface.
EOF
}

doctor() {
    local missing=0 cmd
    printf 'WiFiLab dependencies\n\n'
    for cmd in iw ip nmcli udevadm lspci lsusb sudo; do
        if command -v "$cmd" >/dev/null 2>&1; then
            printf '  [ok]      %s -> %s\n' "$cmd" "$(command -v "$cmd")"
        else
            printf '  [missing] %s\n' "$cmd"
            missing=1
        fi
    done

    if command -v tshark >/dev/null 2>&1; then
        printf '  [optional] tshark -> %s (offline capture analysis available)\n' "$(command -v tshark)"
    else
        printf '  [optional] tshark -> not installed (offline protocol analysis disabled)\n'
    fi

    if command -v capinfos >/dev/null 2>&1; then
        printf '  [optional] capinfos -> %s (capture inspection available)\n' "$(command -v capinfos)"
    else
        printf '  [optional] capinfos -> not installed (deep capture inspection disabled)\n'
    fi

    if command -v dumpcap >/dev/null 2>&1; then
        if [[ -x $(command -v dumpcap) ]]; then
            printf '  [optional] dumpcap -> %s (current user may execute)\n' "$(command -v dumpcap)"
        else
            printf '  [optional] dumpcap -> %s (current user may not execute)\n' "$(command -v dumpcap)"
        fi
    else
        printf '  [optional] dumpcap -> not installed (pcap capture disabled)\n'
    fi

    printf '\nWireless interfaces discovered: '
    mapfile -t ifaces < <(wifilab_wireless_ifaces)
    printf '%d\n' "${#ifaces[@]}"
    printf 'Regulatory domain: %s\n' "$(wifilab_regdomain)"

    return "$missing"
}

resolve_optional_iface() {
    local explicit=${1-}
    if [[ -n $explicit ]]; then
        printf '%s\n' "$explicit"
    else
        wifilab_resolve_selected
    fi
}

case "${1:-adapters}" in
    adapters|list|info) wifilab_discover_human ;;
    --json|json) wifilab_discover_json ;;
    doctor) doctor ;;
    select)
        [[ $# -le 2 ]] || { usage >&2; exit 2; }
        wifilab_select "${2-}"
        ;;
    status)
        case $# in
            1) wifilab_status ;;
            2)
                [[ $2 == --json || $2 == json ]] || { usage >&2; exit 2; }
                wifilab_status_json
                ;;
            *) usage >&2; exit 2 ;;
        esac
        ;;
    radio)
        [[ $# -eq 2 && ( $2 == --json || $2 == json ) ]] || { usage >&2; exit 2; }
        wifilab_radio_status_json
        ;;
    channels)
        [[ $# -eq 2 && ( $2 == --json || $2 == json ) ]] || { usage >&2; exit 2; }
        wifilab_channels_json
        ;;
    telemetry)
        [[ $# -eq 2 && ( $2 == --json || $2 == json ) ]] || { usage >&2; exit 2; }
        wifilab_telemetry_json
        ;;
    protocols)
        [[ $# -eq 2 && ( $2 == --json || $2 == json ) ]] || { usage >&2; exit 2; }
        wifilab_protocols_json
        ;;
    capture)
        case "${2-}" in
            status)
                [[ $# -eq 3 && ( $3 == --json || $3 == json ) ]] || { usage >&2; exit 2; }
                wifilab_capture_status_json
                ;;
            run)
                case $# in
                    2) wifilab_capture_run_json ;;
                    3) wifilab_capture_run_json "$3" ;;
                    4) wifilab_capture_run_json "$3" "$4" ;;
                    *) usage >&2; exit 2 ;;
                esac
                ;;
            latest)
                [[ $# -eq 3 && ( $3 == --json || $3 == json ) ]] || { usage >&2; exit 2; }
                wifilab_capture_latest_json
                ;;
            protocols)
                [[ $# -eq 4 && ( $4 == --json || $4 == json ) ]] || { usage >&2; exit 2; }
                wifilab_capture_protocols_json "$3"
                ;;
            inspect)
                [[ $# -eq 4 && ( $4 == --json || $4 == json ) ]] || { usage >&2; exit 2; }
                wifilab_capture_inspect_json "$3"
                ;;
            *) usage >&2; exit 2 ;;
        esac
        ;;
    captures)
        [[ $# -eq 2 && ( $2 == --json || $2 == json ) ]] || { usage >&2; exit 2; }
        wifilab_captures_json
        ;;
    monitor)
        [[ $# -le 2 ]] || { usage >&2; exit 2; }
        iface=$(resolve_optional_iface "${2-}")
        wifilab_monitor "$iface"
        ;;
    managed)
        [[ $# -le 2 ]] || { usage >&2; exit 2; }
        iface=$(resolve_optional_iface "${2-}")
        wifilab_managed "$iface"
        ;;
    restore)
        [[ $# -le 2 ]] || { usage >&2; exit 2; }
        iface=$(resolve_optional_iface "${2-}")
        wifilab_restore "$iface"
        ;;
    channel)
        case $# in
            2)
                iface=$(wifilab_resolve_selected)
                wifilab_channel "$iface" "$2"
                ;;
            3) wifilab_channel "$2" "$3" ;;
            *) usage >&2; exit 2 ;;
        esac
        ;;
    help|-h|--help) usage ;;
    *)
        printf 'wifilab: unknown command: %s\n\n' "$1" >&2
        usage >&2
        exit 2
        ;;
esac
