#!/usr/bin/env bash

set -euo pipefail

SOURCE=${BASH_SOURCE[0]}
while [[ -L "$SOURCE" ]]; do
    SOURCE_DIR=$(cd -P -- "$(dirname -- "$SOURCE")" && pwd)
    TARGET=$(readlink -- "$SOURCE")
    if [[ $TARGET == /* ]]; then
        SOURCE=$TARGET
    else
        SOURCE="$SOURCE_DIR/$TARGET"
    fi
done

SCRIPT_DIR=$(cd -P -- "$(dirname -- "$SOURCE")" && pwd)
ROOT_DIR=$(cd -- "$SCRIPT_DIR/.." && pwd)

# shellcheck source=../lib/wifilab/discover.sh
source "$ROOT_DIR/lib/wifilab/discover.sh"
# shellcheck source=../lib/wifilab/state.sh
source "$ROOT_DIR/lib/wifilab/state.sh"

usage() {
    cat <<'EOF'
WiFiLab

Usage:
  wifilab list
  wifilab info
  wifilab --json
  wifilab doctor
  wifilab monitor <iface>
  wifilab managed <iface>
  wifilab restore <iface>
  wifilab channel <iface> <channel>
  wifilab help

Read-only commands:
  list      Show discovered wireless adapters
  info      Alias for list
  --json    Emit machine-readable adapter discovery output
  doctor    Check dependencies and basic discovery health

State commands:
  monitor   Safely release one idle wireless interface from NetworkManager
            and switch it to monitor mode
  managed   Switch one idle wireless interface to managed mode and return it
            to NetworkManager
  restore   Deterministically restore one idle wireless interface to managed
            mode with NetworkManager ownership
  channel   Set the channel of an interface already in monitor mode

Safety:
  WiFiLab refuses state changes on the currently connected system Wi-Fi
  interface. It never globally kills or restarts NetworkManager.
EOF
}

doctor() {
    local missing=0 cmd
    printf 'WiFiLab dependencies\n\n'
    for cmd in iw ip nmcli udevadm lspci lsusb sudo; do
        if command -v "$cmd" >/dev/null 2>&1; then
            printf '  [ok]      %s -> %s\n' "$cmd" "$(command -v "$cmd")"
        else
            printf '  [missing] %s\n' "$cmd"
            missing=1
        fi
    done

    printf '\nWireless interfaces discovered: '
    mapfile -t ifaces < <(wifilab_wireless_ifaces)
    printf '%d\n' "${#ifaces[@]}"
    printf 'Regulatory domain: %s\n' "$(wifilab_regdomain)"

    return "$missing"
}

case "${1:-list}" in
    list|info)
        wifilab_discover_human
        ;;
    --json|json)
        wifilab_discover_json
        ;;
    doctor)
        doctor
        ;;
    monitor)
        [[ $# -eq 2 ]] || { usage >&2; exit 2; }
        wifilab_monitor "$2"
        ;;
    managed)
        [[ $# -eq 2 ]] || { usage >&2; exit 2; }
        wifilab_managed "$2"
        ;;
    restore)
        [[ $# -eq 2 ]] || { usage >&2; exit 2; }
        wifilab_restore "$2"
        ;;
    channel)
        [[ $# -eq 3 ]] || { usage >&2; exit 2; }
        wifilab_channel "$2" "$3"
        ;;
    help|-h|--help)
        usage
        ;;
    *)
        printf 'wifilab: unknown command: %s\n\n' "$1" >&2
        usage >&2
        exit 2
        ;;
esac
