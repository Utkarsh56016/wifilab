#!/usr/bin/env bash

set -euo pipefail

SOURCE=${BASH_SOURCE[0]}
while [[ -L "$SOURCE" ]]; do
    SOURCE_DIR=$(cd -P -- "$(dirname -- "$SOURCE")" && pwd)
    TARGET=$(readlink -- "$SOURCE")
    if [[ $TARGET == /* ]]; then
        SOURCE=$TARGET
    else
        SOURCE="$SOURCE_DIR/$TARGET"
    fi
done

SCRIPT_DIR=$(cd -P -- "$(dirname -- "$SOURCE")" && pwd)
ROOT_DIR=$(cd -- "$SCRIPT_DIR/.." && pwd)

source "$ROOT_DIR/lib/wifilab/discover.sh"
source "$ROOT_DIR/lib/wifilab/radio.sh"
source "$ROOT_DIR/lib/wifilab/state.sh"
source "$ROOT_DIR/lib/wifilab/safety.sh"
source "$ROOT_DIR/lib/wifilab/json.sh"
source "$ROOT_DIR/lib/wifilab/select.sh"
source "$ROOT_DIR/lib/wifilab/telemetry.sh"
source "$ROOT_DIR/lib/wifilab/capture.sh"
source "$ROOT_DIR/lib/wifilab/capture_inventory.sh"
source "$ROOT_DIR/lib/wifilab/capture_analysis.sh"
source "$ROOT_DIR/lib/wifilab/capture_inspect.sh"
source "$ROOT_DIR/lib/wifilab/capture_viewer.sh"
source "$ROOT_DIR/lib/wifilab/network_inventory.sh"
source "$ROOT_DIR/lib/wifilab/network_context.sh"
source "$ROOT_DIR/lib/wifilab/network_roles.sh"
source "$ROOT_DIR/lib/wifilab/network_lab_path.sh"
source "$ROOT_DIR/lib/wifilab/network_topology.sh"
source "$ROOT_DIR/lib/wifilab/network_wifi_scan.sh"
source "$ROOT_DIR/lib/wifilab/network_profiles.sh"
source "$ROOT_DIR/lib/wifilab/network_profile_actions.sh"

usage() {
    cat <<'EOF'
WiFiLab

Usage:
  wifilab adapters
  wifilab list
  wifilab info
  wifilab --json
  wifilab doctor
  wifilab select [iface]
  wifilab status [--json]
  wifilab radio --json
  wifilab channels --json
  wifilab telemetry --json
  wifilab protocols --json
  wifilab network interfaces --json
  wifilab network context --json
  wifilab network roles --json
  wifilab network lab-path --json
  wifilab network topology --json
  wifilab network wifi-scan <iface> --json
  wifilab network profiles --json
  wifilab network profile-preflight <iface> <uuid> --json
  wifilab network profile-connect <iface> <uuid> --json
  wifilab network profile-disconnect <iface> --json
  wifilab network profile-reconnect <iface> <uuid> --json
  wifilab capture status --json
  wifilab capture run [duration_seconds] [max_kib]
  wifilab capture latest --json
  wifilab capture protocols <capture_id|latest> --json
  wifilab capture inspect <capture_id|latest> --json
  wifilab capture viewer status --json
  wifilab capture open <capture_id|latest>
  wifilab capture reveal <capture_id|latest>
  wifilab captures --json
  wifilab monitor [iface]
  wifilab managed [iface]
  wifilab restore [iface]
  wifilab channel [iface] <channel>
  wifilab help

Discovery:
  adapters  Show discovered wireless adapters
  list      Alias for adapters
  info      Alias for adapters
  --json    Emit machine-readable adapter discovery output
  doctor    Check dependencies and basic discovery health

Selection:
  select    Persist a physical lab-adapter identity. With no interface,
            auto-select the sole idle USB wireless candidate.
  status    Resolve the selected physical adapter to its current runtime
            interface and show live state. Add --json for UI/agent use.

Read-only UI/agent data:
  radio --json
            Emit the selected adapter's current channel/frequency when known.
  channels --json
            Emit kernel-advertised channels and regulatory flags for the
            selected adapter PHY.
  telemetry --json
            Emit selected-interface RX/TX byte/packet counters. The UI derives
            rates from consecutive samples without packet capture or root.
  protocols --json
            Analyze the newest saved WiFiLab capture offline with tshark -r.
            This compatibility command never opens a live capture interface.
  network interfaces --json
            Emit one read-only record for every kernel network interface with
            observed link, NetworkManager, wireless, driver, bus, MTU, master,
            counter, and sysfs metadata.
  network context --json
            Emit read-only IPv4/IPv6 addressing, NetworkManager DNS context,
            normalized main-table routes, gateways, default-route ownership,
            effective resolv.conf context, and current protection reasons.
  network roles --json
            Derive PRIMARY, LAB, AUXILIARY, VIRTUAL, and TUNNEL roles from the
            persisted physical LAB selection plus current interface/route state.
            LAB/default-route conflicts are reported explicitly and never hidden.
  network lab-path --json
            Derive the selected LAB adapter's current Layer-3 state and compare
            it with the workstation PRIMARY/default-route path. This is a
            destination-independent main-table view; it never probes or mutates
            routing and never invents a gateway for a monitor-only LAB adapter.
  network topology --json
            Emit the current-network-namespace topology graph using kernel link
            metadata, sysfs master/lower relationships, veth peer evidence, and
            Phase 8 interface roles. Cross-namespace peers stay explicitly
            unresolved rather than being fabricated as local nodes.
  network wifi-scan <iface> --json
            Request an adapter-explicit NetworkManager connectable-Wi-Fi scan and
            emit SSID/BSSID, signal percentage, frequency, channel, band,
            security, saved-profile state, and connected state. Monitor-mode or
            NetworkManager-unmanaged adapters return an explicit blocked state;
            NETWORK never restores or changes their radio mode automatically.
  network profiles --json
            Emit saved NetworkManager Wi-Fi profile metadata without querying
            passwords, PSKs, 802.1X secrets, or secret-agent values.
  network profile-preflight <iface> <uuid> --json
            Read-only saved-profile activation preflight. Reports adapter state,
            PRIMARY protection, profile binding/active-device conflicts, current
            default-route owners, and whether the profile may install defaults.
  capture status --json
            Report whether bounded passive capture is available, permitted,
            safe for the selected adapter, and ready in the current radio mode.
  capture latest --json
            Emit the newest WiFiLab-created capture with manifest-backed
            historical radio metadata when available.
  capture protocols <capture_id|latest> --json
            Analyze one validated WiFiLab-owned saved PCAPNG offline. Capture
            identifiers are confined to the WiFiLab capture directory; symbolic
            links and arbitrary filesystem paths are refused.
  capture inspect <capture_id|latest> --json
            Inspect one validated saved PCAPNG on demand. Returns lightweight
            inventory metadata, SHA-256 integrity state, and capinfos-derived
            file type, encapsulation, packet count, size, duration and timestamps.
  capture viewer status --json
            Report graphical-session, Wireshark GUI, and desktop-opener
            availability without launching anything.
  captures --json
            List WiFiLab-created captures. Existing name/bytes/file fields are
            retained while richer capture metadata is added.

Saved-profile connection actions:
  network profile-connect <iface> <uuid> --json
            Activate one explicit saved Wi-Fi profile on one explicit non-PRIMARY
            managed adapter. Profiles capable of installing IPv4/IPv6 default
            routes are refused. Default-route ownership is snapshotted before and
            after activation; validation failure triggers best-effort rollback.
  network profile-disconnect <iface> --json
            Disconnect one explicit non-PRIMARY Wi-Fi adapter only when it does
            not own an IPv4/IPv6 default route. Default-route owners must remain
            unchanged; unexpected movement triggers best-effort reconnect.
  network profile-reconnect <iface> <uuid> --json
            Re-run the same guarded saved-profile activation contract after an
            explicit disconnect. No credential arguments are accepted.

Capture:
  capture run [duration_seconds] [max_kib]
            Save one bounded passive pcapng from the selected physical adapter.
            Defaults: 10 seconds and 10240 KiB. Allowed duration: 1..300 seconds.
            Allowed size limit: 256..102400 KiB. Capture requires monitor mode,
            refuses protected/default-route interfaces, and never uses sudo,
            pkexec, or the privileged radio helper.
  capture open <capture_id|latest>
            Open one validated WiFiLab-owned saved capture in the Wireshark GUI.
            The viewer is launched as the current desktop user with no privilege
            escalation. Arbitrary paths and symbolic-link captures are refused.
  capture reveal <capture_id|latest>
            Validate the selected WiFiLab capture and reveal its capture directory
            through the normal desktop opener. No permissions are changed.

State commands:
  monitor   Switch the selected adapter to monitor mode. An explicit iface
            may still be supplied for diagnostics or recovery.
  managed   Switch the selected adapter to managed mode and return it to
            NetworkManager.
  restore   Deterministically restore the selected adapter to managed mode
            with NetworkManager ownership.
  channel   Set a monitor-mode channel. Usage: `wifilab channel 11` for the
            selected adapter, or `wifilab channel wlan6 11` explicitly.

Safety:
  WiFiLab refuses radio state changes on wireless interfaces carrying an active
  NetworkManager connection or a system default route. Selection stores physical
  metadata rather than wlanX/phyX names. WiFiLab never globally kills or restarts
  NetworkManager. Passive capture resolves that same physical selection again at
  capture time and refuses protected interfaces. Saved-PCAP analysis, inspection,
  viewer launch and reveal stay confined to validated WiFiLab capture identifiers
  and never require sudo or pkexec. NETWORK 8A-8E are read-only. NETWORK 8F may
  request an adapter-explicit NetworkManager scan only. NETWORK 8G saved-profile
  mutations are explicit, refuse PRIMARY/default-route targets, refuse profiles
  that may install default routes on a secondary adapter, never accept secrets,
  and require pre/post default-route validation with best-effort rollback.
EOF
}

doctor() {
    local missing=0 cmd
    printf 'WiFiLab dependencies\n\n'
    for cmd in iw ip nmcli jq udevadm lspci lsusb sudo; do
        if command -v "$cmd" >/dev/null 2>&1; then
            printf '  [ok]      %s -> %s\n' "$cmd" "$(command -v "$cmd")"
        else
            printf '  [missing] %s\n' "$cmd"
            missing=1
        fi
    done

    if command -v tshark >/dev/null 2>&1; then
        printf '  [optional] tshark -> %s (offline capture analysis available)\n' "$(command -v tshark)"
    else
        printf '  [optional] tshark -> not installed (offline protocol analysis disabled)\n'
    fi

    if command -v capinfos >/dev/null 2>&1; then
        printf '  [optional] capinfos -> %s (capture inspection available)\n' "$(command -v capinfos)"
    else
        printf '  [optional] capinfos -> not installed (deep capture inspection disabled)\n'
    fi

    if command -v wireshark >/dev/null 2>&1; then
        printf '  [optional] wireshark -> %s (capture GUI viewer available)\n' "$(command -v wireshark)"
    else
        printf '  [optional] wireshark -> not installed (GUI viewer unavailable)\n'
    fi

    if command -v xdg-open >/dev/null 2>&1; then
        printf '  [optional] desktop opener -> %s\n' "$(command -v xdg-open)"
    elif command -v gio >/dev/null 2>&1; then
        printf '  [optional] desktop opener -> %s open\n' "$(command -v gio)"
    else
        printf '  [optional] desktop opener -> unavailable (reveal disabled)\n'
    fi

    if command -v dumpcap >/dev/null 2>&1; then
        if [[ -x $(command -v dumpcap) ]]; then
            printf '  [optional] dumpcap -> %s (current user may execute)\n' "$(command -v dumpcap)"
        else
            printf '  [optional] dumpcap -> %s (current user may not execute)\n' "$(command -v dumpcap)"
        fi
    else
        printf '  [optional] dumpcap -> not installed (pcap capture disabled)\n'
    fi

    printf '\nWireless interfaces discovered: '
    mapfile -t ifaces < <(wifilab_wireless_ifaces)
    printf '%d\n' "${#ifaces[@]}"
    printf 'Regulatory domain: %s\n' "$(wifilab_regdomain)"

    return "$missing"
}

resolve_optional_iface() {
    local explicit=${1-}
    if [[ -n $explicit ]]; then
        printf '%s\n' "$explicit"
    else
        wifilab_resolve_selected
    fi
}

case "${1:-adapters}" in
    adapters|list|info) wifilab_discover_human ;;
    --json|json) wifilab_discover_json ;;
    doctor) doctor ;;
    select)
        [[ $# -le 2 ]] || { usage >&2; exit 2; }
        wifilab_select "${2-}"
        ;;
    status)
        case $# in
            1) wifilab_status ;;
            2)
                [[ $2 == --json || $2 == json ]] || { usage >&2; exit 2; }
                wifilab_status_json
                ;;
            *) usage >&2; exit 2 ;;
        esac
        ;;
    radio)
        [[ $# -eq 2 && ( $2 == --json || $2 == json ) ]] || { usage >&2; exit 2; }
        wifilab_radio_status_json
        ;;
    channels)
        [[ $# -eq 2 && ( $2 == --json || $2 == json ) ]] || { usage >&2; exit 2; }
        wifilab_channels_json
        ;;
    telemetry)
        [[ $# -eq 2 && ( $2 == --json || $2 == json ) ]] || { usage >&2; exit 2; }
        wifilab_telemetry_json
        ;;
    protocols)
        [[ $# -eq 2 && ( $2 == --json || $2 == json ) ]] || { usage >&2; exit 2; }
        wifilab_protocols_json
        ;;
    network)
        case "${2-}" in
            interfaces)
                [[ $# -eq 3 && ( $3 == --json || $3 == json ) ]] || { usage >&2; exit 2; }
                wifilab_network_interfaces_json
                ;;
            context)
                [[ $# -eq 3 && ( $3 == --json || $3 == json ) ]] || { usage >&2; exit 2; }
                wifilab_network_context_json
                ;;
            roles)
                [[ $# -eq 3 && ( $3 == --json || $3 == json ) ]] || { usage >&2; exit 2; }
                wifilab_network_roles_json
                ;;
            lab-path)
                [[ $# -eq 3 && ( $3 == --json || $3 == json ) ]] || { usage >&2; exit 2; }
                wifilab_network_lab_path_json
                ;;
            topology)
                [[ $# -eq 3 && ( $3 == --json || $3 == json ) ]] || { usage >&2; exit 2; }
                wifilab_network_topology_json
                ;;
            wifi-scan)
                [[ $# -eq 4 && ( $4 == --json || $4 == json ) ]] || { usage >&2; exit 2; }
                wifilab_network_wifi_scan_json "$3"
                ;;
            profiles)
                [[ $# -eq 3 && ( $3 == --json || $3 == json ) ]] || { usage >&2; exit 2; }
                wifilab_network_profiles_json
                ;;
            profile-preflight)
                [[ $# -eq 5 && ( $5 == --json || $5 == json ) ]] || { usage >&2; exit 2; }
                wifilab_network_profile_preflight_json "$3" "$4"
                ;;
            profile-connect)
                [[ $# -eq 5 && ( $5 == --json || $5 == json ) ]] || { usage >&2; exit 2; }
                wifilab_network_profile_connect_json "$3" "$4"
                ;;
            profile-disconnect)
                [[ $# -eq 4 && ( $4 == --json || $4 == json ) ]] || { usage >&2; exit 2; }
                wifilab_network_profile_disconnect_json "$3"
                ;;
            profile-reconnect)
                [[ $# -eq 5 && ( $5 == --json || $5 == json ) ]] || { usage >&2; exit 2; }
                wifilab_network_profile_reconnect_json "$3" "$4"
                ;;
            *) usage >&2; exit 2 ;;
        esac
        ;;
    capture)
        case "${2-}" in
            status)
                [[ $# -eq 3 && ( $3 == --json || $3 == json ) ]] || { usage >&2; exit 2; }
                wifilab_capture_status_json
                ;;
            run)
                case $# in
                    2) wifilab_capture_run_json ;;
                    3) wifilab_capture_run_json "$3" ;;
                    4) wifilab_capture_run_json "$3" "$4" ;;
                    *) usage >&2; exit 2 ;;
                esac
                ;;
            latest)
                [[ $# -eq 3 && ( $3 == --json || $3 == json ) ]] || { usage >&2; exit 2; }
                wifilab_capture_latest_json
                ;;
            protocols)
                [[ $# -eq 4 && ( $4 == --json || $4 == json ) ]] || { usage >&2; exit 2; }
                wifilab_capture_protocols_json "$3"
                ;;
            inspect)
                [[ $# -eq 4 && ( $4 == --json || $4 == json ) ]] || { usage >&2; exit 2; }
                wifilab_capture_inspect_json "$3"
                ;;
            viewer)
                [[ $# -eq 4 && $3 == status && ( $4 == --json || $4 == json ) ]] || { usage >&2; exit 2; }
                wifilab_capture_viewer_status_json
                ;;
            open)
                [[ $# -eq 3 ]] || { usage >&2; exit 2; }
                wifilab_capture_open "$3"
                ;;
            reveal)
                [[ $# -eq 3 ]] || { usage >&2; exit 2; }
                wifilab_capture_reveal "$3"
                ;;
            *) usage >&2; exit 2 ;;
        esac
        ;;
    captures)
        [[ $# -eq 2 && ( $2 == --json || $2 == json ) ]] || { usage >&2; exit 2; }
        wifilab_captures_json
        ;;
    monitor)
        [[ $# -le 2 ]] || { usage >&2; exit 2; }
        iface=$(resolve_optional_iface "${2-}")
        wifilab_monitor "$iface"
        ;;
    managed)
        [[ $# -le 2 ]] || { usage >&2; exit 2; }
        iface=$(resolve_optional_iface "${2-}")
        wifilab_managed "$iface"
        ;;
    restore)
        [[ $# -le 2 ]] || { usage >&2; exit 2; }
        iface=$(resolve_optional_iface "${2-}")
        wifilab_restore "$iface"
        ;;
    channel)
        case $# in
            2)
                iface=$(wifilab_resolve_selected)
                wifilab_channel "$iface" "$2"
                ;;
            3) wifilab_channel "$2" "$3" ;;
            *) usage >&2; exit 2 ;;
        esac
        ;;
    help|-h|--help) usage ;;
    *)
        printf 'wifilab: unknown command: %s\n\n' "$1" >&2
        usage >&2
        exit 2
        ;;
esac
