// WiFiLab floating-window integration for niri.
// Validated against current niri 26.04 window-rule syntax.
// Install by including this file from ~/.config/niri/config.kdl after `niri validate`.

window-rule {
    match app-id=r#"^io\.github\.utkarsh56016\.wifilab$"#

    // WiFiLab is a utility panel, not a scrolling-layout application.
    open-floating true
    default-column-width { fixed 1040; }
    default-window-height { fixed 720; }

    // Match the DMS/Archcraft rounded utility-window treatment.
    geometry-corner-radius 24
    clip-to-geometry true

    // A small compositor opacity reduction lets the niri blur show through
    // without making the instrumentation difficult to read. This opacity is
    // applied on top of the QML surface opacity, so keep it deliberately mild.
    opacity 0.965

    background-effect {
        xray false
        blur true
        noise 0.004
        saturation 1.08
    }
}
